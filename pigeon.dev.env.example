# Copy this file to pigeon.dev.env and fill in real values. That file is
# git-ignored and must never be committed — see docs/adr/0008-scaleway-provider.md.
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PIGEON_DEV_ZONE_ID=
# pigeon.dev no longer manages its own DigitalOcean resources — these three
# must be set to noisypigeon.com's real bucket/Spaces credentials, since
# pigeon.dev's leaves share noisypigeon.com's Terraform state bucket. See
# docs/adr/0008-scaleway-provider.md.
DIGITALOCEAN_SPACES_ACCESS_ID=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_TERRAFORM_STATE_BUCKET=
