# Copy this file to scaleway/.env and fill in real values. That file is
# git-ignored and must never be committed — see docs/adr/0009-per-provider-root-hcl.md.
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_ORGANIZATION_ID=
# Shared Terraform state backend credentials — must match digitalocean/.env's
# values (same bucket). Keep all copies in sync if these ever rotate. Not
# actually used yet (this provider's leaf keeps a local backend override
# for now), but kept here for when it moves to the shared backend.
DIGITALOCEAN_SPACES_ACCESS_ID=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_TERRAFORM_STATE_BUCKET=
