# Copy this file to scaleway/.env and fill in real values. That file is
# git-ignored and must never be committed — see docs/adr/0009-per-provider-root-hcl.md.
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_ORGANIZATION_ID=
# Terraform state backend — Scaleway's own Object Storage bucket (not the
# digitalocean/cloudflare shared one). Backend auth reuses
# SCALEWAY_ACCESS_KEY/SCALEWAY_SECRET_KEY above — see
# docs/adr/0010-scaleway-remote-state.md.
SCALEWAY_TERRAFORM_STATE_BUCKET_NAME=
