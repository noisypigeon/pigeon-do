# Copy this file to noisypigeon.com.env and fill in real values. That file
# is git-ignored and must never be committed — see
# docs/adr/0008-scaleway-provider.md.
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_NOISYPIGEON_COM_ZONE_ID=
DIGITALOCEAN_TOKEN=
# DIGITALOCEAN_SPACES_ACCESS_ID/SECRET_KEY/TERRAFORM_STATE_BUCKET below are
# also used as the shared Terraform state backend for pigeon.dev's leaves
# (pigeon.dev.env copies these same values) — see docs/adr/0008-scaleway-provider.md.
DIGITALOCEAN_SPACES_ACCESS_ID=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_TERRAFORM_STATE_BUCKET=
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_ORGANIZATION_ID=
