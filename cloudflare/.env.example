# Copy this file to cloudflare/.env and fill in real values. That file is
# git-ignored and must never be committed — see docs/adr/0009-per-provider-root-hcl.md.
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_NOISYPIGEON_COM_ZONE_ID=
# Shared Terraform state backend credentials — must match digitalocean/.env's
# values (same bucket). Keep all copies in sync if these ever rotate.
DIGITALOCEAN_SPACES_ACCESS_ID=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_TERRAFORM_STATE_BUCKET=
