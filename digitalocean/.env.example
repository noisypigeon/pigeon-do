# Copy this file to digitalocean/.env and fill in real values. That file is
# git-ignored and must never be committed — see docs/adr/0009-per-provider-root-hcl.md.
# DIGITALOCEAN_SPACES_ACCESS_ID/SECRET_KEY/TERRAFORM_STATE_BUCKET are also
# duplicated into cloudflare/.env and scaleway/.env (same shared state
# backend bucket) — keep all three in sync if these ever rotate. Also
# copied into pigeon.dev.env for pigeon.dev's leaves — see
# docs/adr/0008-scaleway-provider.md.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_SPACES_ACCESS_ID=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_TERRAFORM_STATE_BUCKET=
# Bucket Names
BUCKET_NAME_DATA_EMAIL=
BUCKET_NAME_BACKBLAZE_IMPORT=
